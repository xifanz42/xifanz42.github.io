    <item>
      <title>NL2SQL Agent: Ask Before You Query</title>
      <link>https://xifanz42.github.io/portfolio/nl2sql-dify-case-study/</link>
      <pubDate>Fri, 11 Sep 2026 00:00:00 +0000</pubDate>
      <author>xifan.zou@outlook.com (Xifan)</author>
      <guid>https://xifanz42.github.io/portfolio/nl2sql-dify-case-study/</guid>
      <description>A self-built agent that pauses to ask clarifying questions before generating SQL — instead of guessing at ambiguous requests like most NL2SQL chatbots do. Built on a small classifier, a dedicated SQL coder, and a business-context database dictionary to handle real-world schema ambiguity.</description>
      <media:content xmlns:media="http://search.yahoo.com/mrss/" url="https://xifanz42.github.io/portfolio/nl2sql-dify-case-study/featured.png" />
    </item>
    
